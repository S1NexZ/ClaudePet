{
  "name": "claude-pet",
  "private": true,
  "version": "0.6.0",
  "main": "dist/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "productName": "ccPet",
  "description": "ccPet: a desktop pet that shares live Claude Code sessions with the terminal",
  "author": "S1NexZ",
  "build": {
    "appId": "local.claudepet.app",
    "productName": "ccPet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/bridge",
        "to": "bridge"
      },
      {
        "from": "../build/hook",
        "to": "hook"
      },
      {
        "from": "../models",
        "to": "models"
      },
      {
        "from": "../scripts/pet-claude.py",
        "to": "scripts/pet-claude.py"
      },
      {
        "from": "../scripts/install-shell-integration.sh",
        "to": "scripts/install-shell-integration.sh"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "extraResources": [
        {
          "from": "helper",
          "to": "helper"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "ccPet",
      "runAfterFinish": true,
      "artifactName": "ccPet-Setup-${version}.exe"
    },
    "publish": null,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "S1NexZ <noreply@users.noreply.github.com>",
      "synopsis": "A desktop pet for Claude Code",
      "desktop": {
        "Name": "ccPet",
        "Comment": "A desktop pet for Claude Code",
        "StartupWMClass": "ccPet"
      }
    },
    "appImage": {
      "artifactName": "ccPet-${version}-linux-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "ccPet-${version}-linux-${arch}.deb"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      },
      "artifactName": "ccPet-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "ccPet-${version}-mac-${arch}.dmg"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/S1NexZ/ClaudePet.git"
  },
  "dependencies": {
    "gsap": "^3.15.1"
  }
}
