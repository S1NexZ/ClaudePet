{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccPet",
  "version": "0.7.4",
  "identifier": "local.claudepet.app",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "S1NexZ",
    "shortDescription": "A desktop pet for Claude Code sessions",
    "resources": {
      "../../build/hook/ccpet-bridge": "resources/hook/ccpet-bridge",
      "../../build/hook/ccpet-hook": "resources/hook/ccpet-hook",
      "../../models/": "resources/models/",
      "../../scripts/pet-claude.py": "resources/scripts/pet-claude.py",
      "../../scripts/install-shell-integration.sh": "resources/scripts/install-shell-integration.sh",
      "../../LICENSE": "resources/LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "resources/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
